# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://robolearn.vercel.app

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# Optional comma-separated fallback keys:
# GEMINI_API_KEYS=your_key_1,your_key_2
GEMINI_MODEL=gemini-3.6-flash

# Tavily Web Search API
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase PostgreSQL Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your_password@aws-0-region.pooler.supabase.com:5432/postgres

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

